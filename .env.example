# Supabase project credentials (safe, public anon key — never put the
# service_role key in a NEXT_PUBLIC_* variable or in client code).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Feature flag: when false (default), the app uses the static catalog in
# src/data/products.ts. Set to true only after running
# supabase/migrations/002_catalog_inventory_pricing.sql and
# supabase/seed/001_catalog_demo.sql, to switch /catalog, /product/[id] and
# the cart over to CatalogContext + Supabase data.
NEXT_PUBLIC_USE_SUPABASE_CATALOG=false

# Feature flag: favorites (heart button, header count, /favorites page).
# Works independently of NEXT_PUBLIC_USE_SUPABASE_CATALOG:
# - catalog=false (static 20-product catalog): favorites are stored in this
#   browser's localStorage (key "dekoro_static_favorites"), for guests and
#   signed-in users alike. No SQL migration needed for this mode.
# - catalog=true: favorites are stored in Supabase (public.favorites, one
#   row per signed-in user per product) — requires running
#   supabase/migrations/003_favorites.sql first, and signing in.
NEXT_PUBLIC_USE_SUPABASE_FAVORITES=false

# Feature flag: Quick Order (/quick-order page + its header nav link).
# Kept off by default while the feature is finished — set to true to enable
# it locally or for a release. Any value other than the exact string "true"
# (including unset) keeps it disabled and redirects /quick-order to /catalog.
NEXT_PUBLIC_ENABLE_QUICK_ORDER=false
